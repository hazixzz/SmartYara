# SmartYARA Environment Variables
# Copy this file to .env and fill in your keys

SECRET_KEY=smartyara-change-this-in-production

# Get from Google Cloud Console → APIs & Services → Credentials
GEMINI_API_KEY=your_gemini_api_key_here
GCP_NLP_API_KEY=your_google_cloud_nlp_api_key_here

# Optional: seed an admin account on first start (no default is created otherwise)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Gemini model for rule generation (default: gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash
# Thinking level for Gemini 3.x: low (default), medium, high; 3.6 also accepts minimal
GEMINI_THINKING_LEVEL=low

# Optional second Gemini model, tried if GEMINI_MODEL fails (e.g. gemini-3.5-flash); empty = skip
# (gemini-2.5-flash is no longer available to new API keys)
GEMINI_FALLBACK_MODEL=

# Seconds to wait per Gemini attempt (3 attempts); lower = faster switch to local model
GEMINI_TIMEOUT=90

# Local backup LLM via Ollama, tried after Gemini and before the template rule
OLLAMA_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b
